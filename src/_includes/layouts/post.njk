---
layout: layouts/base.njk
---

<article>
  <header class="mb-8">
    <h1 class="text-4xl font-bold mb-4">{{ title }}</h1>
    <div class="flex flex-wrap gap-4 text-sm text-gray-600">
      <span>作者：<a href="{{ site.authorUrl }}" rel="author" class="hover:text-blue-600 transition">{{ site.author }}</a></span>
      <span>發布：<time datetime="{{ date | dateIso }}">{{ date | dateDisplay }}</time></span>
      {% if updated %}<span>更新：<time datetime="{{ updated | dateIso }}">{{ updated | dateDisplay }}</time></span>{% endif %}
      <span>{{ content | readingTime }} 分鐘閱讀</span>
    </div>
    {% if tags %}
    <div class="mt-4 flex flex-wrap gap-2">
      {% for tag in tags %}
        {% if tag != "posts" %}
        <a href="/tags/{{ tag | slug }}/" class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm hover:bg-blue-200 transition">
          #{{ tag }}
        </a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
    {% set postTopics = topics | topicsForPost(page.url) %}
    {% if postTopics.length %}
    <div class="mt-4 text-sm text-gray-600">
      <span>所屬主題：</span>
      {% for topic in postTopics %}
      <a href="/topics/{{ topic.slug }}/" class="text-blue-600 hover:text-blue-800 transition">{{ topic.shortTitle }}</a>{% if not loop.last %}<span>、</span>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <div class="prose prose-lg max-w-none">
    {{ content | safe }}
  </div>
</article>

{% set related = collections.posts | relatedPosts(page.url, topics, 3) %}
{% if related.length %}
<section class="mt-12" aria-labelledby="related-posts-title">
  <h2 id="related-posts-title" class="text-2xl font-bold mb-6">延伸閱讀</h2>
  <div class="space-y-6">
  {% for post in related %}
    {% include "components/post-card.njk" %}
  {% endfor %}
  </div>
</section>
{% endif %}

{% set conceptNotes = collections.notes | backlinksForTarget(page.url) %}
{% if conceptNotes.length %}
<section class="mt-12" aria-labelledby="related-notes-title">
  <h2 id="related-notes-title" class="text-2xl font-bold mb-6">相關概念</h2>
  <div class="space-y-6">
  {% for post in conceptNotes %}
    {% include "components/garden-note-card.njk" %}
  {% endfor %}
  </div>
</section>
{% endif %}

<script type="module" src="/assets/js/article-lottie.js?v={{ build.version }}"></script>
