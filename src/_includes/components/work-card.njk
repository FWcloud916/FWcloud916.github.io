<article data-work-id="{{ work.id }}" class="overflow-hidden bg-white rounded-lg shadow-md hover:shadow-lg transition md:grid md:grid-cols-[16rem_1fr]">
  {% if work.image %}
  <div class="bg-white md:flex md:items-center">
    <img src="{{ work.image }}"
         alt="{{ work.imageAlt }}"
         class="w-full"
         sizes="(min-width: 48rem) 16rem, calc(100vw - 2rem)"
         loading="lazy"
         decoding="async">
  </div>
  {% endif %}

  <div class="p-6">
    <p class="text-sm font-bold text-blue-600">{{ workCategoryLabel }}</p>
    <h3 class="mt-1 text-2xl font-bold text-gray-900">{{ work.title }}</h3>
    <p class="mt-3 text-gray-700">{{ work.description }}</p>

    <div class="mt-4 flex flex-wrap gap-2" aria-label="技術標籤">
      {% for tag in work.tags %}
      <span class="rounded bg-gray-100 px-2 py-1 text-sm text-gray-700">{{ tag }}</span>
      {% endfor %}
    </div>

    {% if work.installCommand %}
    <div class="mt-5">
      <p class="mb-2 text-sm font-bold text-gray-700">安裝指令</p>
      <pre class="overflow-x-auto rounded-lg bg-gray-900 p-4 text-sm text-gray-100"><code>{{ work.installCommand }}</code></pre>
    </div>
    {% endif %}

    <div class="mt-6 flex flex-wrap gap-3">
      <a href="{{ work.primaryAction.url }}"
         target="_blank"
         rel="noopener"
         class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition">
        {{ work.primaryAction.label }}<span aria-hidden="true">↗</span>
      </a>
      {% if work.relatedPost %}
      <a href="{{ work.relatedPost }}"
         class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-white px-5 py-2.5 text-blue-600 hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 transition">
        閱讀設計文章<span aria-hidden="true">→</span>
      </a>
      {% endif %}
    </div>
  </div>
</article>
